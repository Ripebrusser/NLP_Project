emeClr val="tx1"/></a:solidFill><a:latin typeface="+mn-lt"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:defRPr></a:lvl6pPr><a:lvl7pPr marL="2971800" indent="-228600" algn="l" defTabSz="914400" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="90000"/></a:lnSpc><a:spcBef><a:spcPts val="500"/></a:spcBef><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/><a:defRPr sz="1800" kern="1200"><a:solidFill><a:schemeClr val="tx1"/></a:solidFill><a:latin typeface="+mn-lt"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:defRPr></a:lvl7pPr><a:lvl8pPr marL="3429000" indent="-228600" algn="l" defTabSz="914400" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="90000"/></a:lnSpc><a:spcBef><a:spcPts val="500"/></a:spcBef><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/><a:defRPr sz="1800" kern="1200"><a:solidFill><a:schemeClr val="tx1"/></a:solidFill><a:latin typeface="+mn-lt"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:defRPr></a:lvl8pPr><a:lvl9pPr marL="3886200" indent="-228600" algn="l" defTabSz="914400" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="90000"/></a:lnSpc><a:spcBef><a:spcPts val="500"/></a:spcBef><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/><a:defRPr sz="1800" kern="1200"><a:solidFill><a:schemeClr val="tx1"/></a:solidFill><a:latin typeface="+mn-lt"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:defRPr></a:lvl9pPr></a:lstStyle><a:p><a:pPr lvl="0"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="Ø"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" dirty="0"/><a:t>Cybersecurity threats increasingly surface in social media, messaging, and everyday online text not just network logs.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="Ø"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" dirty="0"/><a:t>NLP can automatically flag suspicious or threat-related text, but most existing systems are built for English or other high-resource languages.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="Ø"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" dirty="0"/><a:t>Malayalam users frequently mix Malayalam script, Romanized Malayalam (Manglish), and Malayalam-English code-mixed text creating transliteration noise, spelling variation, and code-switching that standard NLP pipelines aren't tuned for.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="Ø"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" dirty="0"/><a:t>Existing Malayalam/Manglish NLP research (</a:t></a:r><a:r><a:rPr lang="en-IN" sz="2400" dirty="0" err="1"/><a:t>DravidianCodeMix</a:t></a:r><a:r><a:rPr lang="en-IN" sz="2400" dirty="0"/><a:t>, </a:t></a:r><a:r><a:rPr lang="en-IN" sz="2400" dirty="0" err="1"/><a:t>DravidianLangTech</a:t></a:r><a:r><a:rPr lang="en-IN" sz="2400" dirty="0"/><a:t>) is concentrated on offensive language, hate speech, and sentiment not cybersecurity-specific threats leaving this intersection largely unexplored.</a:t></a:r></a:p><a:p><a:pPr algn="just"><a:lnSpc><a:spcPct val="150000"/></a:lnSpc><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="Ø"/><a:tabLst><a:tab pos="2865120" algn="l"/></a:tabLst></a:pPr><a:endParaRPr lang="en-US" sz="2200" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>